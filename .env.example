# Relative SQLite paths resolve from backend/, regardless of working directory.
DATABASE_URL=sqlite:///data/subcadence.db
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]
# Stage 2: set locally before enabling authentication or seeding.
ADMIN_EMAIL=
ADMIN_PASSWORD=
AUTH_SECRET_KEY=
# Stage 2: optional email delivery settings; no SMTP calls in Stage 1.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
