# Relative SQLite paths resolve from backend/, regardless of working directory.
DATABASE_URL=sqlite:///data/subcadence.db
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]
APP_ENV=development
PASSWORD_RESET_BASE_URL=http://localhost:3000/reset-password
# Set locally before enabling authentication or explicitly seeding an admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# At least 32 UTF-8 bytes and 8 distinct characters; no surrounding whitespace.
AUTH_SECRET_KEY=
# Empty SMTP settings select the sensitive local database outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
SMTP_TIMEOUT=5
